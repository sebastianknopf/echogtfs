{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug",
      "type": "debugpy",
      "request": "attach",
      "preLaunchTask": "excdebug",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/backend/src",
          "remoteRoot": "/app/backend/src"
        },
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/app"
        }
      ],
      "justMyCode": false,
      "subProcess": true
    },
    {
      "name": "Debug (Tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": [
        "discover"
      ],
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": false,
      "subProcess": true,
      "console": "integratedTerminal"
    }
  ]
}
